                }`}
              >
                <span>{variation.label}</span>
                <span
                  className={`text-[9.5px] px-1.5 py-0.2 rounded-full font-semibold ${
                    isActive
                      ? 'bg-white/20 text-white'
                      : 'bg-[#f2eeff] text-[#7248ea]'
                  }`}
                >
                  {variation.badge}
                </span>
              </button>
