      const id = /\b(id|class|aria-label|data-region)="([^"]+)"/i.exec(attrs);
      out.push({ snippet: `<svg${attrs.slice(0, 80).replace(/\s+/g, ' ')}...> (${paths} shapes, ${budget} chars of path data${long ? `, ${long}px` : ''})`, label: id ? id[2] : null, paths, budget, long });
    }
  }
