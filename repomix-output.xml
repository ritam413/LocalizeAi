<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>LOCALIZE — Autonomous Post-Production Studio</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <style>
    :root {
      /* Ditto Color System */
      --color-deep-ink: #130e30;
      --color-hi-yellow: #ffe228;
      --color-moss-green: #59e25d;
      --color-fuchsia: #e261e5;
      --color-slate: #5f5c6e;
      --color-canvas: #f9fbf2;
      --color-soft-meadow: #eff2e5;
      --color-charcoal: #222222;
      --color-onyx: #000000;
      --color-pure-white: #ffffff;

      /* Netflix Sans Typography Token (Inter with custom weights) */
      --font-netflix-sans: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
      --font-mono: 'JetBrains Mono', monospace;

      /* Emil Kowalski Motion Curves */
      --ease-out: cubic-bezier(0.23, 1, 0.32, 1);
      --ease-in-out: cubic-bezier(0.77, 0, 0.175, 1);
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      background-color: var(--color-canvas);
      color: var(--color-deep-ink);
      font-family: var(--font-netflix-sans);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      overflow-x: hidden;
    }

    /* Top Navigation Bar */
    header {
      padding: 16px 36px;
      border-bottom: 1.5px solid var(--color-soft-meadow);
      background: var(--color-soft-meadow);
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      flex-wrap: wrap;
    }

    .brand-group {
      display: flex;
      align-items: center;
      gap: 14px;
    }

    .brand-wordmark {
      font-size: 24px;
      font-weight: 900;
      letter-spacing: -0.03em;
      color: var(--color-deep-ink);
      text-transform: uppercase;
    }

    .brand-divider {
      width: 1.5px;
      height: 22px;
      background: var(--color-slate);
      opacity: 0.3;
    }

    .studio-title {
      font-size: 14px;
      font-weight: 700;
      color: var(--color-deep-ink);
      letter-spacing: -0.01em;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .studio-badge {
      font-size: 10px;
      font-family: var(--font-mono);
      padding: 3px 10px;
      border-radius: 9999px;
      background: var(--color-canvas);
      border: 1px solid var(--color-deep-ink);
      color: var(--color-deep-ink);
      font-weight: 700;
      text-transform: uppercase;
    }

    .header-actions {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    /* Buttons */
    .btn {
      font-family: var(--font-netflix-sans);
      font-size: 13px;
      font-weight: 600;
      padding: 10px 20px;
      border-radius: 9999px;
      border: 1.5px solid var(--color-deep-ink);
      background: var(--color-soft-meadow);
      color: var(--color-deep-ink);
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      transition: transform 160ms var(--ease-out), background 160ms ease;
      user-select: none;
    }

    .btn:active {
      transform: scale(0.97);
    }

    .btn:hover {
      background: var(--color-canvas);
    }

    .btn-yellow {
      background: var(--color-hi-yellow);
      border-color: var(--color-deep-ink);
      color: var(--color-deep-ink);
      font-weight: 700;
    }

    .btn-yellow:hover {
      background: #ebd020;
    }

    .btn-dark {
      background: var(--color-deep-ink);
      border-color: var(--color-deep-ink);
      color: var(--color-pure-white);
      font-weight: 600;
    }

    .btn-dark:hover {
      background: var(--color-charcoal);
    }

    /* Main Grid */
    main {
      padding: 28px 36px;
      display: grid;
      grid-template-columns: 1fr 340px;
      gap: 28px;
      flex: 1;
    }

    @media (max-width: 1200px) {
      main {
        grid-template-columns: 1fr;
      }
    }

    /* Top Metrics Ribbon */
    .metrics-ribbon {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 16px;
      margin-bottom: 24px;
    }

    @media (max-width: 900px) {
      .metrics-ribbon {
        grid-template-columns: repeat(2, 1fr);
      }
    }

    .metric-card {
      background: var(--color-soft-meadow);
      border: 1.5px solid rgba(19, 14, 48, 0.08);
      border-radius: 16px;
      padding: 18px 22px;
      display: flex;
      flex-direction: column;
      gap: 4px;
      transition: transform 160ms var(--ease-out), border-color 160ms ease;
    }

    .metric-card:hover {
      border-color: var(--color-deep-ink);
    }

    .metric-label {
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      color: var(--color-slate);
    }

    .metric-value {
      font-family: var(--font-mono);
      font-size: 24px;
      font-weight: 800;
      color: var(--color-deep-ink);
      font-variant-numeric: tabular-nums;
    }

    .metric-sub {
      font-size: 11px;
      color: var(--color-slate);
      display: flex;
      align-items: center;
      gap: 4px;
    }

    .gauge-bar-bg {
      height: 6px;
      background: rgba(19, 14, 48, 0.1);
      border-radius: 9999px;
      overflow: hidden;
      margin-top: 8px;
    }

    .gauge-bar-fill {
      height: 100%;
      background: var(--color-hi-yellow);
      width: 25%;
      border-radius: 9999px;
      transition: width 400ms var(--ease-out);
    }

    /* Workflow Studio Panel */
    .workflow-panel {
      background: var(--color-soft-meadow);
      border: 1.5px solid rgba(19, 14, 48, 0.12);
      border-radius: 24px;
      padding: 26px;
      display: flex;
      flex-direction: column;
      gap: 18px;
      position: relative;
    }

    .panel-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      border-bottom: 1.5px solid rgba(19, 14, 48, 0.08);
      padding-bottom: 14px;
    }

    .panel-title {
      font-size: 14px;
      font-weight: 800;
      letter-spacing: -0.01em;
      text-transform: uppercase;
      color: var(--color-deep-ink);
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .live-dot {
      width: 9px;
      height: 9px;
      border-radius: 50%;
      background: var(--color-hi-yellow);
      border: 1.5px solid var(--color-deep-ink);
      animation: pulse-dot 1.8s infinite;
    }

    @keyframes pulse-dot {
      0%, 100% { transform: scale(1); }
      50% { transform: scale(1.2); }
    }

    /* Serpentine (Boustrophedon) Workflow Track */
    .serpentine-container {
      display: flex;
      flex-direction: column;
      gap: 16px;
      position: relative;
      padding: 6px 0;
    }

    .pipeline-row {
      display: grid;
      grid-template-columns: 1fr 36px 1fr 36px 1fr;
      align-items: center;
      gap: 10px;
    }

    /* Animated Downward SVG Conduit Flow Between Row 1 and Row 2 */
    .turn-conduit-wrapper {
      display: flex;
      align-items: center;
      justify-content: flex-end;
      padding-right: calc(16.6% - 18px);
      height: 48px;
      margin: -6px 0;
      position: relative;
    }

    .downward-svg-line {
      width: 44px;
      height: 48px;
      overflow: visible;
    }

    .downward-svg-path {
      fill: none;
      stroke: var(--color-slate);
      stroke-width: 2.5;
      stroke-linecap: round;
      opacity: 0.3;
      transition: stroke 200ms ease, opacity 200ms ease;
    }

    .downward-svg-path.active {
      stroke: var(--color-deep-ink);
      stroke-width: 3;
      opacity: 1;
      stroke-dasharray: 8 4;
      animation: dash-flow 0.8s linear infinite;
    }

    @keyframes dash-flow {
      from { stroke-dashoffset: 24; }
      to { stroke-dashoffset: 0; }
    }

    .turn-label-badge {
      position: absolute;
      right: calc(16.6% + 36px);
      font-family: var(--font-mono);
      font-size: 10.5px;
      font-weight: 700;
      padding: 3px 12px;
      border-radius: 9999px;
      background: var(--color-canvas);
      border: 1.5px solid var(--color-deep-ink);
      color: var(--color-deep-ink);
      text-transform: uppercase;
      opacity: 0;
      transform: scale(0.95);
      transition: opacity 220ms var(--ease-out), transform 220ms var(--ease-out);
    }

    .turn-label-badge.visible {
      opacity: 1;
      transform: scale(1);
    }

    /* Agent Card in Ditto Warm Canvas & Soft Meadow */
    .agent-card {
      background: var(--color-canvas);
      border: 1.5px solid rgba(19, 14, 48, 0.15);
      border-radius: 16px;
      padding: 16px;
      display: flex;
      flex-direction: column;
      gap: 10px;
      cursor: pointer;
      position: relative;
      user-select: none;
      min-width: 0;
      
      /* Emil Kowalski smooth entrance */
      transition: transform 220ms var(--ease-out), opacity 220ms var(--ease-out), border-color 180ms ease, background 180ms ease, box-shadow 180ms ease;
    }

    .agent-card.hidden-node {
      opacity: 0;
      pointer-events: none;
      transform: scale(0.95) translateY(6px);
    }

    .agent-card.visible-node {
      opacity: 1;
      pointer-events: auto;
      transform: scale(1) translateY(0);
    }

    .agent-card:hover {
      border-color: var(--color-deep-ink);
      transform: translateY(-2px);
    }

    .agent-card:active {
      transform: scale(0.97);
    }

    .agent-card.active {
      background: var(--color-canvas);
      border-color: var(--color-deep-ink);
      box-shadow: 0 0 0 3px var(--color-hi-yellow), 0 4px 16px rgba(19, 14, 48, 0.08);
    }

    .agent-card.retrying {
      border-color: var(--color-fuchsia);
      box-shadow: 0 0 0 3px rgba(226, 97, 229, 0.35);
    }

    .agent-card.completed {
      border-color: rgba(19, 14, 48, 0.25);
    }

    .agent-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .agent-step {
      font-family: var(--font-mono);
      font-size: 10px;
      font-weight: 800;
      color: var(--color-slate);
    }

    .status-pill {
      font-family: var(--font-mono);
      font-size: 9.5px;
      font-weight: 700;
      padding: 3px 9px;
      border-radius: 9999px;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      display: inline-flex;
      align-items: center;
      gap: 4px;
    }

    .status-pending { background: rgba(19, 14, 48, 0.06); color: var(--color-slate); }
    .status-running { background: var(--color-hi-yellow); color: var(--color-deep-ink); border: 1px solid var(--color-deep-ink); animation: pulse-yellow-pill 1.2s infinite alternate; }
    .status-retrying { background: var(--color-fuchsia); color: var(--color-pure-white); }
    .status-completed { background: var(--color-moss-green); color: var(--color-deep-ink); font-weight: 800; }

    @keyframes pulse-yellow-pill {
      from { transform: scale(1); }
      to { transform: scale(1.04); }
    }

    .agent-name-group {
      display: flex;
      flex-direction: column;
      gap: 2px;
    }

    .agent-name {
      font-size: 14px;
      font-weight: 800;
      color: var(--color-deep-ink);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .agent-role {
      font-size: 11px;
      color: var(--color-slate);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .agent-duration {
      font-family: var(--font-mono);
      font-size: 18px;
      font-weight: 800;
      color: var(--color-deep-ink);
      font-variant-numeric: tabular-nums;
      display: flex;
      align-items: baseline;
      justify-content: space-between;
    }

    .agent-duration-label {
      font-size: 9px;
      font-weight: 700;
      text-transform: uppercase;
      color: var(--color-slate);
      letter-spacing: 0.04em;
    }

    .agent-progress-bar {
      height: 4px;
      background: rgba(19, 14, 48, 0.08);
      border-radius: 9999px;
      overflow: hidden;
    }

    .agent-progress-fill {
      height: 100%;
      background: var(--color-deep-ink);
      width: 0%;
      border-radius: 9999px;
      transition: width 150ms linear;
    }

    .agent-footer {
      font-size: 10.5px;
      color: var(--color-slate);
      display: flex;
      align-items: center;
      justify-content: space-between;
      border-top: 1px solid rgba(19, 14, 48, 0.08);
      padding-top: 6px;
      font-family: var(--font-mono);
    }

    /* Flow Conduit Arrows */
    .conduit-arrow {
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--color-slate);
      font-weight: 800;
      font-size: 16px;
      opacity: 0;
      transform: scale(0.85);
      transition: opacity 220ms var(--ease-out), transform 220ms var(--ease-out), color 180ms ease;
    }

    .conduit-arrow.visible {
      opacity: 0.5;
      transform: scale(1);
    }

    .conduit-arrow.active {
      opacity: 1;
      color: var(--color-deep-ink);
      animation: pulse-arrow 1s infinite alternate;
    }

    .conduit-arrow.left.active {
      animation: pulse-arrow-left 1s infinite alternate;
    }

    @keyframes pulse-arrow {
      from { transform: translateX(0); }
      to { transform: translateX(4px); }
    }

    @keyframes pulse-arrow-left {
      from { transform: translateX(0); }
      to { transform: translateX(-4px); }
    }

    /* Active Expanded Drilldown Box */
    .agent-drilldown {
      background: var(--color-canvas);
      border: 1.5px solid var(--color-deep-ink);
      border-radius: 16px;
      padding: 18px 20px;
      display: grid;
      grid-template-columns: 1fr 1fr 1fr;
      gap: 16px;
      margin-top: 6px;
      animation: enter-drilldown 200ms var(--ease-out);
    }

    @keyframes enter-drilldown {
      from { opacity: 0; transform: scale(0.98) translateY(4px); }
      to { opacity: 1; transform: scale(1) translateY(0); }
    }

    .drilldown-col {
      display: flex;
      flex-direction: column;
      gap: 5px;
    }

    .drilldown-title {
      font-size: 10px;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: var(--color-slate);
    }

    .drilldown-content {
      font-size: 12px;
      color: var(--color-deep-ink);
      line-height: 1.45;
    }

    .code-pill {
      font-family: var(--font-mono);
      font-size: 11px;
      background: var(--color-soft-meadow);
      padding: 2px 7px;
      border-radius: 6px;
      border: 1px solid rgba(19, 14, 48, 0.2);
      color: var(--color-deep-ink);
      font-weight: 600;
    }

    /* Producer Board Sidebar */
    .producer-board {
      background: var(--color-soft-meadow);
      border: 1.5px solid rgba(19, 14, 48, 0.12);
      border-radius: 24px;
      padding: 24px;
      display: flex;
      flex-direction: column;
      gap: 16px;
    }

    .board-header {
      border-bottom: 1.5px solid rgba(19, 14, 48, 0.08);
      padding-bottom: 12px;
    }

    .board-title {
      font-size: 14px;
      font-weight: 900;
      letter-spacing: -0.01em;
      text-transform: uppercase;
      color: var(--color-deep-ink);
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .board-badge {
      background: var(--color-deep-ink);
      color: var(--color-hi-yellow);
      font-size: 9.5px;
      padding: 3px 8px;
      border-radius: 9999px;
      font-weight: 800;
    }

    .verdict-list {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .verdict-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      font-size: 12px;
      padding: 10px 14px;
      border-radius: 12px;
      background: var(--color-canvas);
      border: 1px solid rgba(19, 14, 48, 0.08);
    }

    .verdict-label {
      color: var(--color-slate);
      font-weight: 500;
    }

    .verdict-val {
      font-family: var(--font-mono);
      font-weight: 700;
      color: var(--color-deep-ink);
    }

    .summary-box {
      background: var(--color-canvas);
      border: 1.5px solid rgba(19, 14, 48, 0.12);
      border-left: 4px solid var(--color-moss-green);
      border-radius: 12px;
      padding: 14px;
      font-size: 12px;
      color: var(--color-deep-ink);
      line-height: 1.45;
    }

    .summary-box.alert {
      border-left-color: var(--color-fuchsia);
      background: #fdf3fe;
    }

    .action-group {
      display: flex;
      flex-direction: column;
      gap: 8px;
      margin-top: auto;
    }

    .btn-full {
      width: 100%;
      justify-content: center;
      padding: 12px;
      font-size: 13px;
    }

    /* Targeted Retry Arc Banner */
    .retry-loop-banner {
      background: #fdf3fe;
      border: 1.5px dashed var(--color-fuchsia);
      border-radius: 12px;
      padding: 12px 16px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      font-size: 12px;
      color: var(--color-deep-ink);
