  // the fetched source still shows only the preflight scaffold, before the
  // failure is surfaced via recoverEmptyCycling.
  const COMPLETED_SOURCE_FALLBACK_RETRIES = 3;
  const COMPLETED_SOURCE_FALLBACK_RETRY_MS = 1200;

