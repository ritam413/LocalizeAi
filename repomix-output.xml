                <span className="text-[10px] font-bold text-[#1a1a1a]">Add Subtitles</span>
                <div className="w-7 h-4 bg-[#7248ea] rounded-full relative">
                  <div className="w-3 h-3 rounded-full bg-white absolute right-0.5 top-0.5 shadow-xs" />
