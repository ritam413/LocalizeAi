    // indentation; only a layout with no impeccable import gets an insert.
    let replaced = false;
    out = out.replace(SVELTE_ROOT_IMPORT_LINE_RE, (line) => {
      if (replaced) return '';
      replaced = true;
      const indent = (line.match(/^[ \t]*/) || [''])[0];
      return indent + importLine + '\n';
