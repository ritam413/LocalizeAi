    ph:"https://www.youtube.com/watch?v=...  或  /Users/you/video.mp4",
    adaptive:"慢变化内容", adaptive_h:"（教学、手写、慢速运镜）",
    ta:"字幕感知", ta_h:"（字卡、演示文稿、屏幕录制）",
