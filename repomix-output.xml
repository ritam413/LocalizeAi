  }

  function removeVariantStateStylesheet() {
    document.getElementById(VARIANT_STATE_STYLE_ID)?.remove();
  }

  function showOriginalDuringDiscard(sessionId) {
    if (!sessionId) return;
    let styleEl = document.getElementById(DISCARD_STATE_STYLE_ID);
    if (!styleEl) {
