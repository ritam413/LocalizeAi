<file path="frontend/app/globals.css">
@tailwind base;
@tailwind components;
@tailwind utilities;

:root {
  /* Canonical Studio Design System Tokens */
  --primary-color: #7248ea;
  --primary-hover: #6847ff;
  --accent-color: #6a33e9;
  --secondary-color: #00d4aa;
  --violet-soft: #f2eeff;
  --violet-tint: #f8f6ff;

  --text-primary: #1a1a1a;
  --text-secondary: #575268;
  --text-light: #9e9e9e;
  --bg-primary: #fbfbfd;
  --bg-secondary: #f8f9fa;
  --paper: #ffffff;
  --bg-dark: #111827;
  --border-color: #bd98ec;
  --line-color: #dbd8e8;

  --qa-success: #14804a;
  --qa-danger: #b42318;
  --qa-warning: #a96f00;
  --qa-info: #409eff;

  --border-radius: 12px;
  --border-radius-large: 20px;
  --shadow-light: 0 2px 8px rgba(0, 0, 0, 0.06);
  --shadow-heavy: 0 20px 50px rgba(26, 20, 55, 0.12);
  --shadow-glow: 0 4px 14px rgba(114, 72, 234, 0.28);

  /* Emil Kowalski Motion Curves */
  --ease-out: cubic-bezier(0.23, 1, 0.32, 1);
  --ease-in-out: cubic-bezier(0.77, 0, 0.175, 1);
  --ease-drawer: cubic-bezier(0.32, 0.72, 0, 1);
}

body {
  background-color: var(--bg-primary);
  color: var(--text-primary);
  font-family: 'Roboto', 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
  overflow-x: hidden;
}

/* Custom Drawer Animations */
.drawer-backdrop {
  transition: opacity 180ms var(--ease-out);
}

.drawer-panel {
  transition: transform 220ms var(--ease-drawer);
}

@media (prefers-reduced-motion: reduce) {
  .drawer-panel {
    transition: opacity 180ms ease;
  }
}

/* Glassmorphism panel */
.glass-panel {
  background: rgba(255, 255, 255, 0.85);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border: 1px solid rgba(189, 152, 236, 0.2);
}

.glass-card {
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(8px);
  border: 1px solid rgba(219, 216, 232, 0.8);
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
  transition: all 0.2s ease-in-out;
}

.glass-card:hover {
  border-color: rgba(114, 72, 234, 0.4);
  box-shadow: 0 4px 16px rgba(114, 72, 234, 0.12);
}

/* Keyframe Animations */
@keyframes pulse-violet {
  0%, 100% {
    box-shadow: 0 0 0 0 rgba(114, 72, 234, 0.4);
  }
  50% {
    box-shadow: 0 0 0 8px rgba(114, 72, 234, 0);
  }
}

@keyframes dash-flow {
  from { stroke-dashoffset: 24; }
  to { stroke-dashoffset: 0; }
}

@keyframes pulse-arrow {
  0% { transform: translateX(0); }
  100% { transform: translateX(4px); }
}

@keyframes pulse-arrow-left {
  0% { transform: translateX(0); }
  100% { transform: translateX(-4px); }
}

.animate-pulse-violet {
  animation: pulse-violet 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
}

.animate-dash-flow {
  stroke-dasharray: 8 4;
  animation: dash-flow 0.8s linear infinite;
}

/* Impeccable Shimmer Skeleton Loading Animation */
@keyframes shimmer {
  100% {
    transform: translateX(100%);
  }
}

.animate-shimmer {
  position: relative;
  overflow: hidden;
}

.animate-shimmer::after {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  transform: translateX(-100%);
  background-image: linear-gradient(
    90deg,
    rgba(255, 255, 255, 0) 0,
    rgba(255, 255, 255, 0.35) 20%,
    rgba(255, 255, 255, 0.6) 60%,
    rgba(255, 255, 255, 0)
  );
  animation: shimmer 1.8s cubic-bezier(0.23, 1, 0.32, 1) infinite;
  content: '';
}

@media (prefers-reduced-motion: reduce) {
  .animate-shimmer::after {
    animation: none;
    background-image: none;
  }
}

/* Custom scrollbars */
::-webkit-scrollbar {
  width: 6px;
