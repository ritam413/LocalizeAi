# Core Agent Reasoning (Google Cloud AI / Gemini) - REQUIRED
GEMINI_API_KEY=your_gemini_api_key_here

# Server & Environment Settings
ENVIRONMENT=production
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=*

# Paths & Hardware Acceleration
STORAGE_DIR=/app/storage
SHARED_FOLDER_PATH=/app/shared
GPU_VRAM_MB=8192

# Observability & Partner Integrations (Optional)
GRAFANA_URL=https://your-instance.grafana.net
GRAFANA_SERVICE_ACCOUNT_TOKEN=your_grafana_service_account_token_here
PARALLEL_API_KEY=your_parallel_api_key_here
CLICKHOUSE_URL=https://your-clickhouse-host:8443
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=your_password_here

