  <script>
    const agentData = {
      story_analyst: {
        step: 'STEP 01',
        title: 'Story Analyst Agent',
        tech: 'Demucs v4 + Whisper Large-v3 + Diarization',
        input: 'Raw 4K Cinema MP4 Audio Track (5.1 Stem)',
        output: 'Diarized Speakers + Character Sentiment + Formality Map'
      },
      localization_director: {
        step: 'STEP 02',
        title: 'Localization Director Agent',
        tech: 'Gemini 2.5 Pro + Idiom Adaptation Guardrails',
        input: 'Source Transcript + Tone & Emotional Arc Map',
        output: 'Culturally Adapted English Dub Script with Rationale'
      },
      voice_director: {
        step: 'STEP 03',
        title: 'Voice Director Agent',
        tech: 'Neural Voice Casting & Edge TTS Synthesis',
        input: 'Adapted Dialogue Script + Speaker Timestamps',
        output: 'Raw Synthesized English Speech Stems (.wav 48kHz)'
      },
      sync_engineer: {
        step: 'STEP 04',
        title: 'Sync Engineer Agent (Auto-Repair Hero)',
        tech: 'RubberBand atempo 1.25x + Silence Compaction',
        input: 'Raw Voice Stems + Original Cinema Audio Waveform',
        output: 'Time-Stretched Audio Stems (<18ms lip-sync deviation)'
      },
      subtitle_director: {
        step: 'STEP 05',
        title: 'Subtitle Director Agent',
        tech: 'Netflix Subtitle Standard (Max 20 CPS / 42 CPL)',
        input: 'Phonetically Aligned Speech Stems + Translated Script',
        output: 'Master SRT/VTT Subtitles + Multi-Language Tracks'
      },
      qa_agent: {
        step: 'STEP 06',
        title: 'QA Continuity Agent',
        tech: 'Continuous Metric Verifier + Auto-Repair Dispatcher',
        input: 'Final Subtitled Master Video + Multi-track Stems',
        output: 'Readiness Audit (PASS 98.0%) + Distribution Certification'
      }
    };

    function showDrilldown(agentKey) {
      const data = agentData[agentKey];
      if (!data) return;
      document.getElementById('drilldown-step').innerText = data.step;
      document.getElementById('drilldown-title').innerText = data.title;
      document.getElementById('drilldown-tech').innerText = data.tech;
      document.getElementById('drilldown-input').innerText = data.input;
      document.getElementById('drilldown-output').innerText = data.output;
      const modal = document.getElementById('drilldown-modal');
      modal.classList.remove('hidden');
      modal.classList.add('flex');
    }

    function closeDrilldown() {
      const modal = document.getElementById('drilldown-modal');
      modal.classList.add('hidden');
      modal.classList.remove('flex');
    }

    let isApproved = false;
    function toggleApprove() {
      isApproved = !isApproved;
      const btn = document.getElementById('btn-approve');
      const label = document.getElementById('btn-approve-label');
      if (isApproved) {
        btn.classList.remove('bg-[#ffe228]', 'hover:bg-[#ebd020]');
        btn.classList.add('bg-[#59e25d]', 'text-[#130e30]');
        label.innerText = '✓ DISTRIBUTION CERTIFIED';
      } else {
        btn.classList.add('bg-[#ffe228]', 'hover:bg-[#ebd020]');
        btn.classList.remove('bg-[#59e25d]');
        label.innerText = 'APPROVE FOR DISTRIBUTION';
      }
    }

    let activeTrack = 'dub';
    function setTrack(track) {
      activeTrack = track;
      const btnRaw = document.getElementById('btn-raw');
      const btnDub = document.getElementById('btn-dub');
      const trackName = document.getElementById('track-name');
      const audioStatus = document.getElementById('audio-status');

      if (track === 'raw') {
        btnRaw.className = 'btn-tactile px-2.5 py-0.5 rounded-full text-[10px] font-mono font-bold bg-[#130e30] text-white border border-[#130e30] shadow-sm cursor-pointer';
        btnDub.className = 'btn-tactile px-2.5 py-0.5 rounded-full text-[10px] font-mono font-bold text-[#5f5c6e] hover:text-[#130e30] cursor-pointer';
        trackName.innerText = 'Original Dialogue Audio Stem';
        audioStatus.innerText = 'Status: Paused • Track: RAW_DIALOGUE';
      } else {
        btnDub.className = 'btn-tactile px-2.5 py-0.5 rounded-full text-[10px] font-mono font-bold bg-[#ffe228] text-[#130e30] border border-[#130e30] shadow-sm cursor-pointer';
        btnRaw.className = 'btn-tactile px-2.5 py-0.5 rounded-full text-[10px] font-mono font-bold text-[#5f5c6e] hover:text-[#130e30] cursor-pointer';
        trackName.innerText = 'Localized Dub Stem (EN)';
        audioStatus.innerText = 'Status: Paused • Track: LOCALIZED_EN';
      }
    }

    let isPlaying = false;
    function toggleAudioPlay() {
      isPlaying = !isPlaying;
      const iconPlay = document.getElementById('icon-play');
      const audioStatus = document.getElementById('audio-status');
      if (isPlaying) {
        iconPlay.innerHTML = '<rect x="6" y="4" width="4" height="16"></rect><rect x="14" y="4" width="4" height="16"></rect>';
        audioStatus.innerText = `Status: Playing Waveform (48kHz) • Track: ${activeTrack.toUpperCase()}`;
      } else {
        iconPlay.innerHTML = '<polygon points="5 3 19 12 5 21 5 3"></polygon>';
        audioStatus.innerText = `Status: Paused • Track: ${activeTrack.toUpperCase()}`;
      }
    }
  </script>
</body>
</html>
