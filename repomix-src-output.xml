            <svg class="downward-svg-line" viewBox="0 0 44 48">
              <path class="downward-svg-path" id="turn-svg-path" d="M 22 2 L 22 28 C 22 38, 22 46, 22 46" />
              <polygon points="16,36 28,36 22,46" fill="var(--color-deep-ink)" id="turn-svg-arrow" />
            </svg>
          </div>

          <!-- ROW 2: Steps 06 <- 05 <- 04 (Spawned under Step 3, going Left 🠔!) -->
          <div class="pipeline-row">

            <!-- 06. QA Continuity Agent (Directly under Step 01) -->
            <div class="agent-card hidden-node" id="card-qa" onclick="selectAgent('qa')">
