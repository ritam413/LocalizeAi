        btnDub.className = 'btn-tactile px-2.5 py-0.5 rounded-full text-[10px] font-mono font-bold bg-[#ffe228] text-[#130e30] border border-[#130e30] shadow-sm cursor-pointer';
        btnRaw.className = 'btn-tactile px-2.5 py-0.5 rounded-full text-[10px] font-mono font-bold text-[#5f5c6e] hover:text-[#130e30] cursor-pointer';
        trackName.innerText = 'Localized Dub Stem (EN)';
        audioStatus.innerText = 'Status: Paused • Track: LOCALIZED_EN';
      }
    }

    let isPlaying = false;
    function toggleAudioPlay() {
      isPlaying = !isPlaying;
      const iconPlay = document.getElementById('icon-play');
      const audioStatus = document.getElementById('audio-status');
      if (isPlaying) {
        iconPlay.innerHTML = '<rect x="6" y="4" width="4" height="16"></rect><rect x="14" y="4" width="4" height="16"></rect>';
