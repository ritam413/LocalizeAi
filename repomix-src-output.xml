              <div class="agent-footer">
                <span>Atempo: Waiting</span>
                <span>🠔 To Subtitles</span>
              </div>
            </div>

          </div>

        </div>

        <!-- Detailed Telemetry Drilldown Box (Dynamic) -->
        <div class="agent-drilldown" id="drilldown-box">
          <div class="drilldown-col">
            <span class="drilldown-title" id="dd-agent-title">Agent Telemetry: Story Analyst (Step 01)</span>
            <div class="drilldown-content" id="dd-agent-desc">
              Extracts speaker diarization, scene boundaries, emotional tone tags, and cultural idiom flags from raw audio/video stems.
            </div>
          </div>
          <div class="drilldown-col">
            <span class="drilldown-title">Reasoning & Inputs</span>
            <div class="drilldown-content" id="dd-agent-input">
              Input: 44.1kHz audio stream | VAD segments: 3 | Speaker count: 2 characters
            </div>
          </div>
          <div class="drilldown-col">
            <span class="drilldown-title">Action & Handoff</span>
            <div class="drilldown-content" id="dd-agent-action">
              Extracting tone and character profiles. Once complete, will fade in Localization Director (Step 02).
            </div>
          </div>
        </div>

      </div>

    </div>

    <!-- Right Column: The Producer Board -->
    <div class="producer-board">
      <div class="board-header">
        <div class="board-title">
          THE PRODUCER BOARD
          <span class="board-badge">LIVE MASTER</span>
        </div>
      </div>

      <div class="verdict-list">
        <div class="verdict-row">
          <span class="verdict-label">Director Continuity</span>
          <span class="verdict-val" id="pb-continuity" style="color: var(--color-deep-ink);">In Progress...</span>
        </div>
        <div class="verdict-row">
          <span class="verdict-label">Active Stage</span>
          <span class="verdict-val" id="pb-handoff">Step 01: Story Analyst</span>
        </div>
        <div class="verdict-row">
          <span class="verdict-label">Cumulative Latency</span>
          <span class="verdict-val" id="pb-latency">0.00s</span>
        </div>
        <div class="verdict-row">
          <span class="verdict-label">Self-Repair Retries</span>
          <span class="verdict-val" id="pb-retries">0 Loops</span>
        </div>
        <div class="verdict-row">
          <span class="verdict-label">Audio-Lip Drift</span>
          <span class="verdict-val" id="pb-drift" style="color: var(--color-slate);">Measuring...</span>
        </div>
      </div>

      <div>
        <span style="font-size: 11px; font-weight: 800; text-transform: uppercase; color: var(--color-slate); letter-spacing: 0.04em;">Summary Verdict</span>
        <div class="summary-box" id="pb-summary" style="margin-top: 6px;">
          Autonomous post-production crew initialized. Step 01 (Story Analyst) is currently analyzing dialogue acoustics and narrative context.
        </div>
      </div>

      <div class="action-group">
        <button class="btn btn-yellow btn-full" id="btn-approve" onclick="alert('Master release candidate approved for distribution!')">
          ✓ APPROVE FOR DISTRIBUTION
        </button>
        <button class="btn btn-dark btn-full" onclick="alert('Opening Grafana MCP Control Tower on port 3000...')">
          📊 Inspect Telemetry in Grafana
        </button>
      </div>
    </div>
  </main>

  <script>
    const AGENT_DATA = {
      story: {
        title: 'Agent Telemetry: Story Analyst (Step 01)',
        desc: 'Extracts speaker diarization, scene boundaries, emotional tone tags, and cultural idiom flags from raw audio/video stems.',
        input: 'Input: 44.1kHz audio stream | VAD segments: 3 | Speaker count: 2 characters',
        action: 'Extracted tone: "Tense / Melodramatic". Identified 1 cultural idiom needing regional adaptation. Handoff to Localization Director.'
      },
      localizer: {
        title: 'Agent Telemetry: Localization Director (Step 02)',
        desc: 'Produces culturally adapted translations in target language (Spanish/Hindi/French) with explicit reasoning rationale per dialogue segment.',
        input: 'Target Language: Hindi (hi) | Dialogue: "Break a leg out there tonight!"',
        action: 'Adapted idiom to "शुभकामनाएं, आज मंच तुम्हारा है" with explicit rationale to preserve theatrical context. Handoff to Voice Director.'
      },
      voice: {
        title: 'Agent Telemetry: Voice Director (Step 03)',
        desc: 'Selects character-consistent neural voices and synthesizes audio dialogue segments matching character age and emotional tone.',
        input: 'Character: Raul (Male, 30s) -> Neural Voice: hi-IN-MadhurNeural | Pace: 1.05x',
        action: 'Synthesized 3 wav speech segments with character-consistent emotional resonance. Drawing flow down to Sync Engineer in Row 2.'
      },
      sync: {
        title: 'Agent Telemetry: Sync Engineer (Step 04)',
        desc: 'Reconciles translated speech duration against original dialogue timing windows using speed adjustment (atempo), timing shifts, or line shortening.',
        input: 'Original duration: 3.20s | Synthesized: 4.60s (Delta: +1.40s overflow)',
        action: 'Applied atempo=1.25x + silence compression -> Speech duration normalized to 3.18s. Handoff leftward to Subtitle Director.'
      },
      subtitles: {
        title: 'Agent Telemetry: Subtitle Director (Step 05)',
        desc: 'Generates synchronized subtitle files (.srt/.vtt) aligned with final adjusted audio timing and character limits.',
        input: 'Synchronized wav stems + translated text strings | Target CPS limit: 17 chars/sec',
        action: 'Generated drift-free subtitles_hi.srt and subtitles_hi.vtt with perfect 0.00s drift offset. Handoff leftward to QA Continuity Agent.'
      },
      qa: {
        title: 'Agent Telemetry: QA / Continuity Agent (Step 06)',
        desc: 'Inspects assembled cut, calculates release readiness score (0-100), detects defect classes, and coordinates targeted repair loops.',
        input: 'Assembled cut inspection: Audio stems + Subtitles + Source video timing windows',
        action: 'Verified timing adherence (>95%), verified subtitle alignment. Readiness score: 98.0/100 (PASS). Handoff to Director for final cut.'
      }
    };

    function selectAgent(key) {
      const data = AGENT_DATA[key];
      if (!data) return;

      document.querySelectorAll('.agent-card').forEach(c => c.classList.remove('active'));
      const activeCard = document.getElementById(`card-${key}`);
      if (activeCard) activeCard.classList.add('active');

      document.getElementById('dd-agent-title').innerText = data.title;
      document.getElementById('dd-agent-desc').innerText = data.desc;
      document.getElementById('dd-agent-input').innerText = data.input;
      document.getElementById('dd-agent-action').innerText = data.action;
    }

    let simInterval = null;
    let isSimulating = false;

    function resetToInitialState() {
      if (isSimulating) {
        clearInterval(simInterval);
        isSimulating = false;
        document.getElementById('sim-text').innerText = 'Simulate Step-by-Step Flow';
      }

      // Step 1 visible and running
      const cardStory = document.getElementById('card-story');
      cardStory.className = 'agent-card visible-node active';
      document.getElementById('status-story').className = 'status-pill status-running';
      document.getElementById('status-story').innerText = 'RUNNING';
      document.getElementById('time-story').innerText = '0.00s';
      document.getElementById('progress-story').style.width = '0%';

      // Hide steps 2 through 6
      const hiddenAgents = ['localizer', 'voice', 'sync', 'subtitles', 'qa'];
      hiddenAgents.forEach(a => {
        const card = document.getElementById(`card-${a}`);
        const status = document.getElementById(`status-${a}`);
        const time = document.getElementById(`time-${a}`);
        const progress = document.getElementById(`progress-${a}`);
        
        card.className = 'agent-card hidden-node';
        status.className = 'status-pill status-pending';
        status.innerText = 'PENDING';
        time.innerText = '0.00s';
        progress.style.width = '0%';
      });

      // Hide conduit arrows
      [1, 2, 4, 5].forEach(num => {
        const arr = document.getElementById(`arrow-${num}`);
        if (arr) arr.className = 'conduit-arrow' + (num >= 4 ? ' left' : '');
      });

      // Hide downward turn line
      document.getElementById('turn-svg-path').className = 'downward-svg-path';
      document.getElementById('turn-badge').className = 'turn-label-badge';

      // Reset metrics
      document.getElementById('retry-banner').style.display = 'none';
      document.getElementById('total-time-val').innerText = '0.00s';
      document.getElementById('tokens-val').innerText = '480 tok';
      document.getElementById('score-val').innerText = 'Analyzing...';
      document.getElementById('score-fill').style.width = '20%';
      document.getElementById('status-val').innerText = 'IN PROGRESS';
      document.getElementById('active-agent-count').innerText = '● 1 Active Agent';
      document.getElementById('pb-continuity').innerText = 'In Progress...';
      document.getElementById('pb-handoff').innerText = 'Step 01: Story Analyst';
      document.getElementById('pb-latency').innerText = '0.00s';
      document.getElementById('pb-retries').innerText = '0 Loops';
      document.getElementById('pb-drift').innerText = 'Measuring...';
      document.getElementById('pb-summary').className = 'summary-box';
      document.getElementById('pb-summary').innerText = 'Autonomous post-production crew initialized. Step 01 (Story Analyst) is currently analyzing dialogue acoustics and narrative context.';

      selectAgent('story');
    }

    function startOrRestartSimulation() {
      if (isSimulating) {
        clearInterval(simInterval);
        isSimulating = false;
        document.getElementById('sim-text').innerText = 'Simulate Step-by-Step Flow';
        return;
      }

      resetToInitialState();
      isSimulating = true;
      document.getElementById('sim-text').innerText = 'Simulating...';

      const stages = [
        { key: 'story', dur: 1800, nextArrow: 1, nextKey: 'localizer', name: 'Story Analyst', tokens: '480 tok', score: '35%' },
        { key: 'localizer', dur: 2000, nextArrow: 2, nextKey: 'voice', name: 'Localization Director', tokens: '1,120 tok', score: '55%' },
        { key: 'voice', dur: 2800, nextTurn: true, nextKey: 'sync', name: 'Voice Director', tokens: '1,840 tok', score: '70%' },
        { key: 'sync', dur: 1400, nextArrow: 4, nextKey: 'subtitles', name: 'Sync Engineer', tokens: '2,020 tok', score: '82%' },
        { key: 'subtitles', dur: 1000, nextArrow: 5, nextKey: 'qa', name: 'Subtitle Director', tokens: '2,210 tok', score: '90%' },
        { key: 'qa', dur: 2000, nextKey: null, name: 'QA Continuity Agent', tokens: '2,410 tok', score: '98.0%' }
      ];

      let stageIdx = 0;
      let totalElapsed = 0;

      function runStage() {
        if (stageIdx >= stages.length) {
          isSimulating = false;
          document.getElementById('sim-text').innerText = 'Restart Simulation';
          document.getElementById('status-val').innerText = 'APPROVED';
          document.getElementById('score-val').innerText = '98.0%';
          document.getElementById('score-fill').style.width = '98%';
          document.getElementById('pb-continuity').innerText = 'Plan Secured';
          document.getElementById('pb-handoff').innerText = 'Master Release Cut';
          document.getElementById('pb-drift').innerText = '< 18ms';
          document.getElementById('pb-summary').innerText = 'Release Candidate approved for distribution. Timing overflows reconciled, cultural script rationale verified compliant with target audience.';
          selectAgent('qa');
          return;
        }

        const stage = stages[stageIdx];
        const card = document.getElementById(`card-${stage.key}`);
        const status = document.getElementById(`status-${stage.key}`);
        const time = document.getElementById(`time-${stage.key}`);
        const progress = document.getElementById(`progress-${stage.key}`);

        // Reveal this card with smooth Emil Kowalski ease
        card.className = 'agent-card visible-node active';
        status.className = 'status-pill status-running';
        status.innerText = 'RUNNING';
        selectAgent(stage.key);

        document.getElementById('pb-handoff').innerText = `Step 0${stageIdx + 1}: ${stage.name}`;
        document.getElementById('tokens-val').innerText = stage.tokens;
        document.getElementById('active-agent-count').innerText = `● ${stageIdx + 1} of 6 Stages Active`;

        let stageElapsed = 0;
        const stepInterval = 40;

        function getOrganicProgressPct(u) {
          if (u <= 0) return 0;
          if (u >= 1) return 100;
          const kfs = [
            [0.00, 0.00], [0.08, 0.16], [0.18, 0.28], [0.32, 0.38],
            [0.48, 0.65], [0.65, 0.77], [0.80, 0.89], [0.92, 0.96], [1.00, 1.00]
          ];
          for (let i = 0; i < kfs.length - 1; i++) {
            const [u0, p0] = kfs[i];
            const [u1, p1] = kfs[i + 1];
            if (u >= u0 && u <= u1) {
              const r = (u - u0) / (u1 - u0);
              const s = r * r * (3 - 2 * r);
              return (p0 + (p1 - p0) * s) * 100;
            }
          }
          return 100;
        }

        const timer = setInterval(() => {
          stageElapsed += stepInterval;
          totalElapsed += stepInterval;
          
          const u = Math.min(1, stageElapsed / stage.dur);
          const pct = getOrganicProgressPct(u);
          progress.style.width = `${pct.toFixed(1)}%`;
          time.innerText = (Math.min(stage.dur, stageElapsed) / 1000).toFixed(2) + 's';
          document.getElementById('total-time-val').innerText = (totalElapsed / 1000).toFixed(2) + 's';
          document.getElementById('pb-latency').innerText = (totalElapsed / 1000).toFixed(2) + 's';

          if (stageElapsed >= stage.dur) {
            clearInterval(timer);
            progress.style.width = '100%';
            time.innerText = (stage.dur / 1000).toFixed(2) + 's';
            card.className = 'agent-card visible-node completed';
            status.className = 'status-pill status-completed';
            status.innerText = 'DONE';

            // Check if downward line needs to be drawn after Step 03 (Voice Director)
            if (stage.nextTurn) {
              const turnPath = document.getElementById('turn-svg-path');
              const turnBadge = document.getElementById('turn-badge');
              
              turnPath.className = 'downward-svg-path active';
              turnBadge.className = 'turn-label-badge visible';

              setTimeout(() => {
                stageIdx++;
                runStage();
              }, 400);
            } else {
              if (stage.nextArrow) {
                const arrowEl = document.getElementById(`arrow-${stage.nextArrow}`);
                if (arrowEl) {
                  arrowEl.className = 'conduit-arrow visible active' + (stage.nextArrow >= 4 ? ' left' : '');
                }
              }
              stageIdx++;
              runStage();
            }
          }
        }, stepInterval);
      }

      runStage();
    }

    function triggerRetryDemo() {
      resetToInitialState();
      
      // Make all cards visible
      ['story', 'localizer', 'voice', 'sync', 'subtitles', 'qa'].forEach((a, i) => {
        const c = document.getElementById(`card-${a}`);
        c.className = 'agent-card visible-node completed';
        document.getElementById(`status-${a}`).className = 'status-pill status-completed';
        document.getElementById(`status-${a}`).innerText = 'DONE';
        document.getElementById(`progress-${a}`).style.width = '100%';
      });

      // Show conduits
      [1, 2, 4, 5].forEach(num => {
        const arr = document.getElementById(`arrow-${num}`);
        if (arr) arr.className = 'conduit-arrow visible' + (num >= 4 ? ' left' : '');
      });

      document.getElementById('turn-svg-path').className = 'downward-svg-path active';
      document.getElementById('turn-badge').className = 'turn-label-badge visible';

      // Activate retry state
      document.getElementById('retry-banner').style.display = 'flex';
      const syncCard = document.getElementById('card-sync');
      const syncStatus = document.getElementById('status-sync');
      syncCard.className = 'agent-card visible-node retrying';
      syncStatus.className = 'status-pill status-retrying';
      syncStatus.innerText = 'RETRYING #1';
      document.getElementById('time-sync').innerText = '1.40s (atempo)';

      const qaCard = document.getElementById('card-qa');
      const qaStatus = document.getElementById('status-qa');
      qaCard.className = 'agent-card visible-node active';
      qaStatus.className = 'status-pill status-running';
      qaStatus.innerText = 'EVALUATING';

      document.getElementById('score-val').innerText = '78.5% → 98.0%';
      document.getElementById('score-fill').style.width = '78.5%';
      document.getElementById('pb-summary').className = 'summary-box alert';
      document.getElementById('pb-summary').innerText = 'TIMING_OVERFLOW detected in Scene 07: Targeted retry dispatched across Row 2 to Sync Engineer with atempo=1.25x fix proposal.';
      document.getElementById('pb-retries').innerText = '1 Loop (Active)';

      selectAgent('sync');

      setTimeout(() => {
        syncCard.className = 'agent-card visible-node completed';
        syncStatus.className = 'status-pill status-completed';
        syncStatus.innerText = 'FIXED';
        qaCard.className = 'agent-card visible-node completed';
        qaStatus.className = 'status-pill status-completed';
        qaStatus.innerText = 'DONE';
        document.getElementById('score-val').innerText = '98.0%';
        document.getElementById('score-fill').style.width = '98%';
        document.getElementById('pb-summary').className = 'summary-box';
        document.getElementById('pb-summary').innerText = 'Self-repair completed successfully. Quality score restored to 98.0% (Release Ready).';
        document.getElementById('pb-retries').innerText = '1 Loop (Resolved)';
        selectAgent('qa');
      }, 2500);
    }

    // Initialize on page load
    window.onload = resetToInitialState;
  </script>
</body>
</html>
</file>

