  quality_score?: number;
  is_original?: boolean;
}

export interface MultiAudioPlayerProps {
  tracks?: AudioTrackOption[];
  defaultTrackId?: string;
  title?: string;
  onTrackChange?: (track: AudioTrackOption) => void;
}

const DEFAULT_TRACKS: AudioTrackOption[] = [
  {
