                  <span className={`text-[10px] font-mono font-bold px-2.5 py-0.5 rounded-full ${useDemucs ? 'bg-[#7248ea] text-white' : 'bg-[#dbd8e8] text-[#575268]'}`}>
                    {useDemucs ? 'ENABLED' : 'OFF'}
