            <p class="text-[10px] text-slateText mt-1 font-mono">Culture-adapted script + character tone</p>
          </div>
        </div>

        <!-- Whisper ASR Engine Selector with Details -->
        <div>
          <label class="block text-[11px] font-extrabold uppercase tracking-wider text-slateText mb-1.5">
            Whisper ASR Speech Recognition Engine
          </label>
          <div class="relative">
            <select class="w-full bg-canvas border-[1.5px] border-deepInk/20 focus:border-deepInk rounded-xl px-3.5 py-3 text-xs font-bold text-deepInk focus:outline-none focus:ring-2 focus:ring-hiYellow appearance-none cursor-pointer">
              <option value="large-v3" selected>Whisper Large v3 (1550M params • Max Acoustic Precision &amp; Diarization)</option>
