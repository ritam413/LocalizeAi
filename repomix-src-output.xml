describe('TICKET-06: Subtitle Director Agent Contract & Drift Protection', () => {
  const sampleInput: SubtitleDirectorInput = {
    job_id: 'job-sub-01',
    target_language: 'hi',
    localized_lines: [
      {
        segment_id: 1,
        speaker_id: 'speaker_1',
        start_s: 1.0,
        end_s: 4.2,
        translated_text: 'पहले से ही हवा में महल मत बनाओ, दोस्त।',
