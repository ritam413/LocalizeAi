    assert "sidechaincompress=" in filter_str
    assert "threshold=0.05" in filter_str
    assert "attack=20" in filter_str
    assert "release=250" in filter_str
    assert "ratio=4.0" in filter_str
    assert "[ducked_bg]" in filter_str


