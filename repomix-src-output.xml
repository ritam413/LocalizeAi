                <option value="fr">French (fr)</option>
                <option value="pt">Portuguese (pt)</option>
                <option value="ru">Russian (ru)</option>
                <option value="de">German (de)</option>
                <option value="ja">Japanese (ja)</option>
              </select>
              <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-3 text-deepInk">
                <svg class="fill-current h-4 w-4" viewBox="0 0 20 20"><path d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z"/></svg>
              </div>
            </div>
            <p class="text-[10px] text-slateText mt-1 font-mono">Auto-identifies native idioms and tone tags</p>
          </div>

          <!-- Target Dub Language -->
          <div>
            <label class="block text-[11px] font-extrabold uppercase tracking-wider text-slateText mb-1.5">
              Target Release Language
            </label>
            <div class="relative">
              <select class="w-full bg-canvas border-[1.5px] border-deepInk/20 focus:border-deepInk rounded-xl px-3.5 py-3 text-xs font-bold text-deepInk focus:outline-none focus:ring-2 focus:ring-hiYellow appearance-none cursor-pointer">
                <option value="en" selected>English — Global Distribution (en)</option>
                <option value="es">Spanish (es)</option>
                <option value="hi">Hindi — Bollywood Neutral (hi)</option>
                <option value="fr">French (fr)</option>
                <option value="de">German (de)</option>
                <option value="pt">Portuguese (pt)</option>
                <option value="ru">Russian (ru)</option>
              </select>
              <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-3 text-deepInk">
                <svg class="fill-current h-4 w-4" viewBox="0 0 20 20"><path d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z"/></svg>
