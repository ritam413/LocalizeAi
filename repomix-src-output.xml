    subtitle_vtt_url: null,
    quality_score: 100.0,
    is_original: true,
  },
  {
    id: 'spanish',
    language_code: 'es',
    language_name: 'Spanish (Castilian Studio Dub)',
    flag: '🇪🇸',
    voice: 'Alvaro Neural (es-ES)',
    video_url: '/api/v1/clips/preview-stream?path=storage/runs/trial1_multilingual/es/trial1_es_dubbed.mp4',
