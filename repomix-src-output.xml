                        "segment_id": 1,
                        "target_segment_id": 1,
                        "defect_type": "TIMING_OVERFLOW",
                        "syllables_to_reduce": 3,
                        "target_agent": "localization_director",
                        "description": "Overflow",
                        "fix_applied": False,
                    }
                ],
                "decision": "Defect flagged",
                "quality_score": 70.0
            }
        return {
            "job_id": job_id,
            "release_readiness_score": 96.0,
            "verdict": "pass",
            "defect_count": 0,
            "findings": [],
            "decision": "Approved",
