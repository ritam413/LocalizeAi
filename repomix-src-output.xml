      height: 100%;
      background: var(--color-hi-yellow);
      width: 25%;
      border-radius: 9999px;
      transition: width 400ms var(--ease-out);
    }

    /* Workflow Studio Panel */
    .workflow-panel {
      background: var(--color-soft-meadow);
      border: 1.5px solid rgba(19, 14, 48, 0.12);
      border-radius: 24px;
      padding: 26px;
      display: flex;
      flex-direction: column;
      gap: 18px;
      position: relative;
    }

    .panel-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      border-bottom: 1.5px solid rgba(19, 14, 48, 0.08);
      padding-bottom: 14px;
    }

    .panel-title {
      font-size: 14px;
      font-weight: 800;
      letter-spacing: -0.01em;
      text-transform: uppercase;
      color: var(--color-deep-ink);
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .live-dot {
      width: 9px;
      height: 9px;
      border-radius: 50%;
      background: var(--color-hi-yellow);
      border: 1.5px solid var(--color-deep-ink);
      animation: pulse-dot 1.8s infinite;
    }

    @keyframes pulse-dot {
      0%, 100% { transform: scale(1); }
      50% { transform: scale(1.2); }
    }

    /* Serpentine (Boustrophedon) Workflow Track */
    .serpentine-container {
      display: flex;
      flex-direction: column;
      gap: 16px;
      position: relative;
      padding: 6px 0;
    }

    .pipeline-row {
      display: grid;
      grid-template-columns: 1fr 36px 1fr 36px 1fr;
      align-items: center;
      gap: 10px;
    }

    /* Animated Downward SVG Conduit Flow Between Row 1 and Row 2 */
    .turn-conduit-wrapper {
      display: flex;
      align-items: center;
      justify-content: flex-end;
      padding-right: calc(16.6% - 18px);
      height: 48px;
      margin: -6px 0;
      position: relative;
    }

    .downward-svg-line {
      width: 44px;
      height: 48px;
      overflow: visible;
    }

    .downward-svg-path {
      fill: none;
      stroke: var(--color-slate);
      stroke-width: 2.5;
      stroke-linecap: round;
      opacity: 0.3;
      transition: stroke 200ms ease, opacity 200ms ease;
    }

    .downward-svg-path.active {
      stroke: var(--color-deep-ink);
      stroke-width: 3;
      opacity: 1;
      stroke-dasharray: 8 4;
      animation: dash-flow 0.8s linear infinite;
    }

    @keyframes dash-flow {
      from { stroke-dashoffset: 24; }
      to { stroke-dashoffset: 0; }
    }

    .turn-label-badge {
      position: absolute;
      right: calc(16.6% + 36px);
      font-family: var(--font-mono);
      font-size: 10.5px;
      font-weight: 700;
      padding: 3px 12px;
      border-radius: 9999px;
      background: var(--color-canvas);
      border: 1.5px solid var(--color-deep-ink);
      color: var(--color-deep-ink);
      text-transform: uppercase;
      opacity: 0;
      transform: scale(0.95);
      transition: opacity 220ms var(--ease-out), transform 220ms var(--ease-out);
    }

    .turn-label-badge.visible {
      opacity: 1;
      transform: scale(1);
    }

    /* Agent Card in Ditto Warm Canvas & Soft Meadow */
    .agent-card {
      background: var(--color-canvas);
      border: 1.5px solid rgba(19, 14, 48, 0.15);
      border-radius: 16px;
      padding: 16px;
      display: flex;
      flex-direction: column;
      gap: 10px;
      cursor: pointer;
      position: relative;
      user-select: none;
      min-width: 0;
      
      /* Emil Kowalski smooth entrance */
      transition: transform 220ms var(--ease-out), opacity 220ms var(--ease-out), border-color 180ms ease, background 180ms ease, box-shadow 180ms ease;
    }

    .agent-card.hidden-node {
      opacity: 0;
      pointer-events: none;
      transform: scale(0.95) translateY(6px);
    }

    .agent-card.visible-node {
      opacity: 1;
      pointer-events: auto;
      transform: scale(1) translateY(0);
    }

    .agent-card:hover {
      border-color: var(--color-deep-ink);
      transform: translateY(-2px);
    }

    .agent-card:active {
      transform: scale(0.97);
    }

    .agent-card.active {
      background: var(--color-canvas);
      border-color: var(--color-deep-ink);
      box-shadow: 0 0 0 3px var(--color-hi-yellow), 0 4px 16px rgba(19, 14, 48, 0.08);
    }

    .agent-card.retrying {
      border-color: var(--color-fuchsia);
      box-shadow: 0 0 0 3px rgba(226, 97, 229, 0.35);
    }

    .agent-card.completed {
      border-color: rgba(19, 14, 48, 0.25);
    }

    .agent-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .agent-step {
      font-family: var(--font-mono);
      font-size: 10px;
      font-weight: 800;
      color: var(--color-slate);
    }

    .status-pill {
      font-family: var(--font-mono);
      font-size: 9.5px;
      font-weight: 700;
      padding: 3px 9px;
      border-radius: 9999px;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      display: inline-flex;
      align-items: center;
      gap: 4px;
    }

    .status-pending { background: rgba(19, 14, 48, 0.06); color: var(--color-slate); }
    .status-running { background: var(--color-hi-yellow); color: var(--color-deep-ink); border: 1px solid var(--color-deep-ink); animation: pulse-yellow-pill 1.2s infinite alternate; }
    .status-retrying { background: var(--color-fuchsia); color: var(--color-pure-white); }
    .status-completed { background: var(--color-moss-green); color: var(--color-deep-ink); font-weight: 800; }

    @keyframes pulse-yellow-pill {
      from { transform: scale(1); }
      to { transform: scale(1.04); }
    }

    .agent-name-group {
      display: flex;
      flex-direction: column;
      gap: 2px;
    }

    .agent-name {
      font-size: 14px;
      font-weight: 800;
      color: var(--color-deep-ink);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .agent-role {
      font-size: 11px;
      color: var(--color-slate);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .agent-duration {
      font-family: var(--font-mono);
      font-size: 18px;
      font-weight: 800;
      color: var(--color-deep-ink);
      font-variant-numeric: tabular-nums;
      display: flex;
      align-items: baseline;
      justify-content: space-between;
    }

    .agent-duration-label {
      font-size: 9px;
      font-weight: 700;
      text-transform: uppercase;
      color: var(--color-slate);
      letter-spacing: 0.04em;
    }

    .agent-progress-bar {
      height: 4px;
      background: rgba(19, 14, 48, 0.08);
      border-radius: 9999px;
      overflow: hidden;
    }

    .agent-progress-fill {
      height: 100%;
      background: var(--color-deep-ink);
      width: 0%;
      border-radius: 9999px;
      transition: width 150ms linear;
    }

    .agent-footer {
      font-size: 10.5px;
      color: var(--color-slate);
      display: flex;
      align-items: center;
      justify-content: space-between;
      border-top: 1px solid rgba(19, 14, 48, 0.08);
      padding-top: 6px;
      font-family: var(--font-mono);
    }

    /* Flow Conduit Arrows */
    .conduit-arrow {
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--color-slate);
      font-weight: 800;
      font-size: 16px;
      opacity: 0;
      transform: scale(0.85);
      transition: opacity 220ms var(--ease-out), transform 220ms var(--ease-out), color 180ms ease;
    }

    .conduit-arrow.visible {
      opacity: 0.5;
      transform: scale(1);
    }

    .conduit-arrow.active {
      opacity: 1;
      color: var(--color-deep-ink);
      animation: pulse-arrow 1s infinite alternate;
    }

    .conduit-arrow.left.active {
      animation: pulse-arrow-left 1s infinite alternate;
    }

    @keyframes pulse-arrow {
      from { transform: translateX(0); }
      to { transform: translateX(4px); }
    }

    @keyframes pulse-arrow-left {
      from { transform: translateX(0); }
      to { transform: translateX(-4px); }
    }

    /* Active Expanded Drilldown Box */
    .agent-drilldown {
      background: var(--color-canvas);
      border: 1.5px solid var(--color-deep-ink);
      border-radius: 16px;
      padding: 18px 20px;
      display: grid;
      grid-template-columns: 1fr 1fr 1fr;
      gap: 16px;
      margin-top: 6px;
      animation: enter-drilldown 200ms var(--ease-out);
    }

    @keyframes enter-drilldown {
      from { opacity: 0; transform: scale(0.98) translateY(4px); }
      to { opacity: 1; transform: scale(1) translateY(0); }
    }

    .drilldown-col {
      display: flex;
      flex-direction: column;
      gap: 5px;
    }

    .drilldown-title {
      font-size: 10px;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: var(--color-slate);
    }

    .drilldown-content {
      font-size: 12px;
      color: var(--color-deep-ink);
      line-height: 1.45;
    }

    .code-pill {
      font-family: var(--font-mono);
      font-size: 11px;
      background: var(--color-soft-meadow);
      padding: 2px 7px;
      border-radius: 6px;
      border: 1px solid rgba(19, 14, 48, 0.2);
      color: var(--color-deep-ink);
      font-weight: 600;
    }

    /* Producer Board Sidebar */
    .producer-board {
      background: var(--color-soft-meadow);
      border: 1.5px solid rgba(19, 14, 48, 0.12);
      border-radius: 24px;
      padding: 24px;
      display: flex;
      flex-direction: column;
      gap: 16px;
    }

    .board-header {
      border-bottom: 1.5px solid rgba(19, 14, 48, 0.08);
      padding-bottom: 12px;
    }

    .board-title {
      font-size: 14px;
      font-weight: 900;
      letter-spacing: -0.01em;
      text-transform: uppercase;
      color: var(--color-deep-ink);
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .board-badge {
      background: var(--color-deep-ink);
      color: var(--color-hi-yellow);
      font-size: 9.5px;
      padding: 3px 8px;
      border-radius: 9999px;
      font-weight: 800;
    }

    .verdict-list {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .verdict-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      font-size: 12px;
      padding: 10px 14px;
      border-radius: 12px;
      background: var(--color-canvas);
      border: 1px solid rgba(19, 14, 48, 0.08);
    }

    .verdict-label {
      color: var(--color-slate);
      font-weight: 500;
    }

    .verdict-val {
      font-family: var(--font-mono);
      font-weight: 700;
      color: var(--color-deep-ink);
    }

    .summary-box {
      background: var(--color-canvas);
      border: 1.5px solid rgba(19, 14, 48, 0.12);
      border-left: 4px solid var(--color-moss-green);
      border-radius: 12px;
      padding: 14px;
      font-size: 12px;
      color: var(--color-deep-ink);
      line-height: 1.45;
    }

    .summary-box.alert {
      border-left-color: var(--color-fuchsia);
      background: #fdf3fe;
    }

    .action-group {
      display: flex;
      flex-direction: column;
      gap: 8px;
      margin-top: auto;
    }

    .btn-full {
      width: 100%;
      justify-content: center;
      padding: 12px;
      font-size: 13px;
    }

    /* Targeted Retry Arc Banner */
    .retry-loop-banner {
      background: #fdf3fe;
      border: 1.5px dashed var(--color-fuchsia);
      border-radius: 12px;
      padding: 12px 16px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      font-size: 12px;
      color: var(--color-deep-ink);
    }

    .retry-loop-tag {
      font-family: var(--font-mono);
      background: var(--color-fuchsia);
      color: var(--color-pure-white);
      padding: 3px 8px;
      border-radius: 9999px;
      font-weight: 800;
      font-size: 9.5px;
    }
  </style>
</head>
<body>

  <!-- Top Navigation Bar -->
  <header>
    <div class="brand-group">
      <div class="brand-wordmark">LOCALIZE</div>
      <div class="brand-divider"></div>
      <div class="studio-title">
        Autonomous Post-Production Swarm
        <span class="studio-badge">Gemini Reasoning Core</span>
      </div>
    </div>

    <div class="header-actions">
      <button class="btn btn-yellow" id="sim-btn" onclick="startOrRestartSimulation()">
        <span id="sim-icon">▶</span>
        <span id="sim-text">Simulate Step-by-Step Flow</span>
      </button>
      <button class="btn" onclick="triggerRetryDemo()">
        <span>⚡ Demo Targeted Self-Repair</span>
      </button>
      <button class="btn btn-dark" onclick="resetToInitialState()">
        <span>↺ Reset (Step 1 Only)</span>
      </button>
    </div>
  </header>

  <!-- Main Grid -->
  <main>
    <!-- Left Column: HUD & Serpentine Workflow Track -->
    <div style="display: flex; flex-direction: column; gap: 20px;">

      <!-- Top Metrics Ribbon -->
      <div class="metrics-ribbon">
        <div class="metric-card">
          <span class="metric-label">Total Execution Time</span>
          <span class="metric-value" id="total-time-val">1.85s</span>
          <span class="metric-sub">
            <span id="active-agent-count">● 1 Active Agent</span>
          </span>
        </div>

        <div class="metric-card">
          <span class="metric-label">Reasoning & Compute</span>
          <span class="metric-value" id="tokens-val">480 tok</span>
          <span class="metric-sub">
            <span>Google Cloud Gemini 2.5</span>
          </span>
        </div>

        <div class="metric-card">
          <span class="metric-label">Release Readiness Score</span>
          <span class="metric-value" id="score-val" style="color: var(--color-deep-ink);">Analyzing...</span>
          <div class="gauge-bar-bg">
            <div class="gauge-bar-fill" id="score-fill" style="width: 25%;"></div>
          </div>
        </div>

        <div class="metric-card">
          <span class="metric-label">Production Status</span>
          <span class="metric-value" id="status-val" style="color: var(--color-deep-ink); font-size: 20px;">IN PROGRESS</span>
          <span class="metric-sub" id="status-sub">Step 1 of 6 Executing</span>
        </div>
      </div>

      <!-- Swarm Agent Workflow Route Canvas -->
      <div class="workflow-panel">
        <div class="panel-header">
          <div class="panel-title">
            <span class="live-dot"></span>
            Serpentine Agent Workflow Route (Progressive Reveal Flow)
          </div>
          <span style="font-size: 11px; color: var(--color-slate); font-family: var(--font-mono);">
            Click card to inspect Gemini reasoning
          </span>
        </div>

        <!-- Targeted Retry Loop Banner (Dynamic) -->
        <div class="retry-loop-banner" id="retry-banner" style="display: none;">
          <div style="display: flex; align-items: center; gap: 8px;">
            <span class="retry-loop-tag">CLOSED SELF-REPAIR LOOP</span>
            <span>QA Continuity Agent detected <strong>TIMING_OVERFLOW (1.40s)</strong> → Dispatched targeted speed reconciliation (atempo 1.25x) directly to Sync Engineer in Row 2.</span>
          </div>
          <span style="font-family: var(--font-mono); font-size: 11px; font-weight: 700;">Iteration #1 (Resolved)</span>
        </div>

        <!-- Serpentine Two-Row Track Container -->
        <div class="serpentine-container" id="serpentine-container">

          <!-- ROW 1: Steps 01 -> 02 -> 03 (Going Right ➔) -->
          <div class="pipeline-row">

