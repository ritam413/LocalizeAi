              <div class="agent-name-group">
                <span class="agent-name">QA / Continuity</span>
                <span class="agent-role">Release Readiness & Self-Repair</span>
              </div>
              <div class="agent-duration">
                <span id="time-qa">0.00s</span>
                <span class="agent-duration-label">DURATION</span>
              </div>
              <div class="agent-progress-bar">
                <div class="agent-progress-fill" id="progress-qa" style="width: 0%;"></div>
              </div>
              <div class="agent-footer">
                <span>Score: Pending</span>
                <span>➔ Master Cut</span>
              </div>
            </div>

            <!-- Conduit Arrow 5-6 (Pointing Left 🠔) -->
            <div class="conduit-arrow left" id="arrow-5">🠔</div>

            <!-- 05. Subtitle Director (Directly under Step 02) -->
            <div class="agent-card hidden-node" id="card-subtitles" onclick="selectAgent('subtitles')">
              <div class="agent-header">
                <span class="agent-step">STEP 05</span>
                <span class="status-pill status-pending" id="status-subtitles">PENDING</span>
              </div>
              <div class="agent-name-group">
                <span class="agent-name">Subtitle Director</span>
                <span class="agent-role">SRT/VTT Sync & Formatting</span>
              </div>
              <div class="agent-duration">
                <span id="time-subtitles">0.00s</span>
                <span class="agent-duration-label">DURATION</span>
              </div>
              <div class="agent-progress-bar">
                <div class="agent-progress-fill" id="progress-subtitles" style="width: 0%;"></div>
              </div>
              <div class="agent-footer">
                <span>Drift: Pending</span>
                <span>🠔 To QA</span>
              </div>
            </div>

            <!-- Conduit Arrow 4-5 (Pointing Left 🠔) -->
            <div class="conduit-arrow left" id="arrow-4">🠔</div>

            <!-- 04. Sync Engineer (Directly under Step 03) -->
            <div class="agent-card hidden-node" id="card-sync" onclick="selectAgent('sync')">
