                        "sync_adjustments": sync_res["sync_adjustments"]
                    },
                    retry_count=retries_executed
                )
                qa_retry_stems = [
                    {
                        "segment_id": adj["segment_id"],
                        "duration_s": adj["final_duration_s"],
                        "target_window_s": adj["original_window_s"],
