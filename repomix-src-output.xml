          </span>
        </div>

        <div className="grid grid-cols-1 md:grid-cols-3 gap-4 text-xs">
          <div className="flex flex-col gap-1.5 bg-[#fbfbfd] p-3.5 rounded-xl border border-[#dbd8e8]">
