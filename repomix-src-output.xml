        }

    monkeypatch.setattr(director.qa_agent, "run", mock_qa_run)

    # Spy on execute_acoustic_mixdown
    mixdown_calls = []
    original_mixdown = director.execute_acoustic_mixdown

    async def spy_mixdown(*args, **kwargs):
