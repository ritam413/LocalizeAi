      } else if (mode === 'B') {
        btnB.className = 'px-3 py-1.5 text-xs font-bold rounded-[4px] bg-[#2B7FFF] text-white shadow-sm btn-spring flex items-center gap-1.5';
        duckingIndicator.innerText = 'AUTO-DUCKING: -6.0 dB (Auto)';
        rosterCount.innerText = '8 Stages Registered';
      } else if (mode === 'C') {
        btnC.className = 'px-3 py-1.5 text-xs font-bold rounded-[4px] bg-[#2B7FFF] text-white shadow-sm btn-spring flex items-center gap-1.5';
        duckingIndicator.innerText = 'ACTOR AUDIO: 100% PRESERVED';
        rosterCount.innerText = '4 Stages (Subtitles Only)';
      }
      lucide.createIcons();
    }

    // AUDIO TRACK SWITCHER
    function switchTrack(trackId, btnElement) {
      const container = document.getElementById('audio-track-container');
      const buttons = container.querySelectorAll('button');
      buttons.forEach(b => {
        b.className = 'px-2.5 py-1 text-[11px] font-mono rounded-[4px] text-[#94A3B8] hover:text-white btn-spring';
      });
      btnElement.className = 'px-2.5 py-1 text-[11px] font-mono rounded-[4px] bg-[#7248EA] text-white font-bold shadow-sm btn-spring';
    }

    // SCRUBBER
    function handleScrub(event) {
      const rect = event.currentTarget.getBoundingClientRect();
      const clickX = event.clientX - rect.left;
      const ratio = Math.max(0, Math.min(1, clickX / rect.width));
      document.getElementById('video-scrubber-fill').style.transform = `scaleX(${ratio})`;
      
      const totalSec = 121; // 02:01.00
      const currentSec = Math.floor(ratio * totalSec);
      const mins = String(Math.floor(currentSec / 60)).padStart(2, '0');
      const secs = String(currentSec % 60).padStart(2, '0');
      document.getElementById('timecode-display').innerText = `${mins}:${secs}.00`;
    }

    // PLAY/PAUSE TOGGLE
    let isPlaying = false;
    let playInterval = null;
    function togglePlay() {
      isPlaying = !isPlaying;
      const icon = document.getElementById('play-icon');
      if (isPlaying) {
        icon.setAttribute('data-lucide', 'pause');
      } else {
        icon.setAttribute('data-lucide', 'play');
      }
      lucide.createIcons();
    }

    function rewind10() {
      document.getElementById('video-scrubber-fill').style.transform = `scaleX(0)`;
      document.getElementById('timecode-display').innerText = `00:00.00`;
    }
  </script>
