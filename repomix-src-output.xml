  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;600;700&display=swap" rel="stylesheet">
  <script src="https://unpkg.com/lucide@latest"></script>
  <style>
    :root {
      --ease-out: cubic-bezier(0.23, 1, 0.32, 1);
      --ease-in-out: cubic-bezier(0.77, 0, 0.175, 1);
      --ease-drawer: cubic-bezier(0.32, 0.72, 0, 1);
    }
    body {
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
    }
    .font-mono {
      font-family: 'JetBrains Mono', monospace;
    }
    .tabular-nums {
      font-variant-numeric: tabular-nums;
    }

    /* Hardware-Accelerated Tactile Button Spring Physics */
    .btn-spring {
      transition: transform 160ms var(--ease-out), background-color 160ms var(--ease-out), border-color 160ms var(--ease-out), color 160ms var(--ease-out), box-shadow 160ms var(--ease-out);
      will-change: transform;
    }
    .btn-spring:active {
      transform: scale(0.97);
    }
    @media (hover: hover) and (pointer: fine) {
      .btn-spring:hover {
        transform: translateY(-1px);
      }
    }

    /* Sliding Active Segmented Control with GPU Transform */
    .segmented-slider {
      transition: transform 220ms var(--ease-out), width 220ms var(--ease-out);
      will-change: transform, width;
    }

    /* Hardware-Accelerated Waveform Stem Transform */
    .stem-bar {
      transform-origin: left center;
      transition: transform 250ms var(--ease-out);
      will-change: transform;
    }

    /* Sidechain Ducking Pulse (GPU Composited) */
    @keyframes sidechain-pulse {
      0%, 100% { opacity: 0.85; transform: scale(1); }
      50% { opacity: 1; transform: scale(1.008); filter: drop-shadow(0 0 8px rgba(0, 212, 170, 0.4)); }
    }
    .animate-sidechain {
      animation: sidechain-pulse 2.2s var(--ease-in-out) infinite;
      will-change: transform, opacity;
    }

    /* Accessibility: Respect Reduced Motion */
    @media (prefers-reduced-motion: reduce) {
      .btn-spring, .segmented-slider, .stem-bar, .animate-sidechain {
        transition: opacity 160ms ease, background-color 160ms ease !important;
        animation: none !important;
        transform: none !important;
      }
    }
  </style>
</head>
