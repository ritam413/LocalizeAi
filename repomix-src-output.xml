              />
            </svg>
          </div>
        </div>

        {/* ROW 2: Right to Left (Step 04 <- Step 05 <- Step 06) */}
        <div className="grid grid-cols-1 md:grid-cols-[1fr_32px_1fr_32px_1fr] items-center gap-2.5">
          {/* Step 06: QA Continuity Agent (Left) */}
          <AgentCard
