# ==========================================
# DubForge Studio - Git Ignore Configuration
# ==========================================

# ------------------------------------------
# User Uploads, Media Files & Binary Outputs
# ------------------------------------------
*.pdf
*.mp4
*.mkv
*.avi
*.mov
*.webm
*.flv
*.wav
*.mp3
*.aac
*.m4a
*.flac
*.ogg

# Subtitle outputs & generated datasets
*.srt
*.vtt
*.ass
*_detailed.json
*Cover_Letter*

# ------------------------------------------
# Databases & SQLite Storage
# ------------------------------------------
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm

# ------------------------------------------
# Storage Directories (Ignore contents, preserve folder structure via .gitkeep)
# ------------------------------------------
storage/*
!storage/.gitkeep
!storage/*/

storage/uploads/*
!storage/uploads/.gitkeep

storage/runs/*
!storage/runs/.gitkeep

backend/storage/*
!backend/storage/.gitkeep

# ------------------------------------------
# Python Caches & Virtual Environments
# ------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
ENV/
.pytest_cache/
.cache/
*.egg-info/
dist/
build/

# ------------------------------------------
# Node.js & Next.js Frontend
# ------------------------------------------
node_modules/
frontend/node_modules/
.next/
frontend/.next/
.turbo/
.vercel
out/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ------------------------------------------
# Environment Files & Secrets
# ------------------------------------------
.env
.env.local
.env.*.local
.env.development
.env.test
.env.production
!.env.example

# ------------------------------------------
# Operating System & IDE Files
# ------------------------------------------
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
.antigravity/
