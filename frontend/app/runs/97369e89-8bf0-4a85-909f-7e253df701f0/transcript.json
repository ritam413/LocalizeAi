  {
    "start_s": 101.91,
    "end_s": 103.91,
    "source_text": "a to vidělám velikánský penízen a tom."
  },
  {
    "start_s": 103.91,
    "end_s": 105.91,
    "source_text": "Protože tam všechny, všechny nebudu mých malíčkům."
