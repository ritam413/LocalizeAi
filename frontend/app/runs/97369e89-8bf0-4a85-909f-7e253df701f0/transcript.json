[
  {
    "start_s": 7.66,
    "end_s": 8.66,
    "source_text": "Ahoj, Tadka."
  },
  {
    "start_s": 8.66,
    "end_s": 10.66,
    "source_text": "Následá, nazvár."
  },
  {
    "start_s": 10.66,
    "end_s": 11.66,
    "source_text": "Jsou ty tady."
  },
  {
    "start_s": 11.66,
    "end_s": 12.66,
    "source_text": "Jo, pak si máš?"
  },
  {
    "start_s": 12.66,
    "end_s": 13.66,
    "source_text": "Hi, Espen."
  },
  {
    "start_s": 13.66,
    "end_s": 14.66,
    "source_text": "Hi."
  },
  {
    "start_s": 14.66,
    "end_s": 15.66,
    "source_text": "Paráda, paráda."
  },
  {
    "start_s": 15.66,
    "end_s": 18.66,
    "source_text": "O, ještě chodíte, já myslím, že už to se dozešli ráno."
  },
  {
    "start_s": 18.66,
    "end_s": 20.66,
    "source_text": "Ne, ješiš, Maria, to je moje láská bůbecné."
  },
  {
    "start_s": 20.66,
    "end_s": 21.66,
    "source_text": "Tam problém není."
  },
  {
    "start_s": 21.66,
    "end_s": 23.66,
    "source_text": "Problem je teď, že zítra se tady jdou závody."
  },
  {
    "start_s": 23.66,
    "end_s": 24.66,
    "source_text": "Uhu."
  },
  {
    "start_s": 24.66,
    "end_s": 27.66,
    "source_text": "A jsou tady hrozný, drají hotely a všude všechno plní,"
  },
  {
    "start_s": 27.66,
    "end_s": 29.66,
    "source_text": "tak jsem si říkaj, že bych tady u tebe moh přespát."
  },
  {
    "start_s": 29.66,
    "end_s": 32.91,
    "source_text": "Jak jinak?"
  },
  {
    "start_s": 32.91,
    "end_s": 33.91,
    "source_text": "Jak jinak, oj?"
  },
  {
    "start_s": 33.91,
    "end_s": 35.91,
    "source_text": "Uhu."
  },
  {
    "start_s": 35.91,
    "end_s": 39.91,
    "source_text": "Ah, takže neukáží se rok po malou dváty, jo."
  },
  {
    "start_s": 39.91,
    "end_s": 42.91,
    "source_text": "Ale, když poci by někde přespát."
  },
  {
    "start_s": 42.91,
    "end_s": 43.91,
    "source_text": "Tak, přijdeš."
  },
  {
    "start_s": 43.91,
    "end_s": 45.91,
    "source_text": "Táto, tyto, tyto jsou závody."
  },
  {
    "start_s": 45.91,
    "end_s": 46.91,
    "source_text": "Tak bych mohli."
  },
  {
    "start_s": 46.91,
    "end_s": 49.91,
    "source_text": "Velká pouštní, velká pouštní, prostě bytva."
  },
  {
    "start_s": 49.91,
    "end_s": 52.91,
    "source_text": "To není jako tady se nedá ní dezaparkovat."
  },
  {
    "start_s": 52.91,
    "end_s": 54.91,
    "source_text": "Jo, a mašinu máš."
  },
  {
    "start_s": 54.91,
    "end_s": 56.91,
    "source_text": "Mašiné lucusní, to je vyladená."
  },
  {
    "start_s": 56.91,
    "end_s": 58.91,
    "source_text": "Nový ventili, nový válce, nový písty."
  },
  {
    "start_s": 58.91,
    "end_s": 61.91,
    "source_text": "To je všechno, jak má být, nový svody."
  },
  {
    "start_s": 61.91,
    "end_s": 63.91,
    "source_text": "To mám jasně vyhraný prostě."
  },
  {
    "start_s": 63.91,
    "end_s": 64.91,
    "source_text": "Tam není jiná možnost."
  },
  {
    "start_s": 64.91,
    "end_s": 66.91,
    "source_text": "Vždy, co takhle stánu?"
  },
  {
    "start_s": 66.91,
    "end_s": 68.91,
    "source_text": "To je stánu, stánu se nedá jistí."
  },
  {
    "start_s": 68.91,
    "end_s": 70.91,
    "source_text": "Tohle je legendární olieň."
  },
  {
    "start_s": 70.91,
    "end_s": 72.91,
    "source_text": "Ne, vysím jako na spaňí ty vole."
  },
  {
    "start_s": 72.91,
    "end_s": 74.91,
    "source_text": "Na spaňí, jde, tady chcíš spát."
  },
  {
    "start_s": 74.91,
    "end_s": 76.91,
    "source_text": "Vždy se tady podívej, je neská už nemůžíš stánu, vůbec ní jde."
  },
  {
    "start_s": 76.91,
    "end_s": 78.91,
    "source_text": "Ale..."
  },
  {
    "start_s": 80.91,
    "end_s": 82.91,
    "source_text": "No, ale jako když je někdo příjemné,"
  },
  {
    "start_s": 82.91,
    "end_s": 84.91,
    "source_text": "a moce dostomí lej, tak ty..."
  },
  {
    "start_s": 84.91,
    "end_s": 87.91,
    "source_text": "Jo, tady jsou takový dle lidi výtány."
  },
  {
    "start_s": 87.91,
    "end_s": 89.91,
    "source_text": "Výtány, výtány."
  },
  {
    "start_s": 89.91,
    "end_s": 91.91,
    "source_text": "Jo, ale není problém, není problém."
  },
  {
    "start_s": 91.91,
    "end_s": 93.91,
    "source_text": "Takže to je závodný speciál,"
  },
  {
    "start_s": 93.91,
    "end_s": 95.91,
    "source_text": "tam jako to nikdo úpejka řekti, nebude,"
  },
  {
    "start_s": 95.91,
    "end_s": 97.91,
    "source_text": "ale já jsem to teď kapola díl."
  },
  {
    "start_s": 97.91,
    "end_s": 99.91,
    "source_text": "To je prostě tam nemám šanci prohrát."
  },
  {
    "start_s": 99.91,
    "end_s": 101.91,
    "source_text": "Tam je to jasný výtěstí"
