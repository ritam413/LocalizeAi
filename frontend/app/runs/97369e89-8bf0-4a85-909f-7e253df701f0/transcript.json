  },
  {
    "start_s": 125.91,
    "end_s": 127.91,
    "source_text": "a ty jde máš to, no."
  },
  {
    "start_s": 127.91,
    "end_s": 129.91,
    "source_text": "Ne, tak to je samozřejmě nějaký peníze za závod."
  },
  {
    "start_s": 129.91,
    "end_s": 131.91,
    "source_text": "Se dalí, ale..."
  },
  {
    "start_s": 131.91,
    "end_s": 133.91,
    "source_text": "A vědeme, jak si taky jasné trošku?"
  },
  {
    "start_s": 133.91,
