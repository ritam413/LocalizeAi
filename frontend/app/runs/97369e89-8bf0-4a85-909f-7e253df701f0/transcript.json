  },
  {
    "start_s": 261.63,
    "end_s": 263.63,
    "source_text": "A z naši hodinou?"
  },
  {
    "start_s": 263.63,
    "end_s": 264.63,
    "source_text": "Je to velmi."
  },
  {
    "start_s": 264.63,
