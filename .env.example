# ==============================================================================
# LOCALIZE — Production & Development Environment Configuration
# ==============================================================================

# Core Agent Reasoning (Google Cloud AI / Gemini) - REQUIRED
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# Server & Deployment Configuration
# ------------------------------------------------------------------------------
ENVIRONMENT=production
HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Allowed CORS origins (comma-separated for multiple origins or * for open access)
CORS_ORIGINS=*

# Frontend API & WebSocket Endpoints (Docker Compose uses container DNS by default)
BACKEND_URL=http://backend:8000
# Set NEXT_PUBLIC_WS_URL if deploying behind an SSL/TLS domain (e.g., wss://api.yourdomain.com)
# NEXT_PUBLIC_WS_URL=wss://api.yourdomain.com

# ------------------------------------------------------------------------------
# Storage & Database Paths (Defaults to local storage & SQLite)
# ------------------------------------------------------------------------------
# DB_PATH=./storage/dubforge.db
# STORAGE_DIR=./storage
# SHARED_FOLDER_PATH=./shared

# Hardware Acceleration (VRAM in MB)
GPU_VRAM_MB=8192

# ------------------------------------------------------------------------------
# Observability & Partner Integrations (Optional)
# ------------------------------------------------------------------------------
# Parallel Search MCP (Cultural Research & Idioms)
PARALLEL_API_KEY=your_parallel_api_key_here

# ClickHouse Analytics MCP
CLICKHOUSE_URL=https://your-clickhouse-host:8443
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=your_password_here

