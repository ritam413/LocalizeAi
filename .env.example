# ==============================================================================
# LOCALIZE — Production & Development Environment Configuration
# ==============================================================================

# Core Agent Reasoning (Local Ollama or Google Cloud AI / Gemini)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_KEEP_ALIVE=0
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# Server & Deployment Configuration
# ------------------------------------------------------------------------------
ENVIRONMENT=production
HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Allowed CORS origins (set * or your laptop IP, e.g. http://localhost:3000,http://192.168.0.xxx:3000)
CORS_ORIGINS=*

# Frontend API & WebSocket Endpoints (When running Frontend on laptop, point to Desktop IP)
# Example for laptop .env.local:
# BACKEND_URL=http://192.168.0.107:8000
# NEXT_PUBLIC_WS_URL=ws://192.168.0.107:8000
BACKEND_URL=http://backend:8000
NEXT_PUBLIC_WS_URL=

# ------------------------------------------------------------------------------
# Storage & Database Paths (Defaults to local storage & SQLite)
# ------------------------------------------------------------------------------
# DB_PATH=./storage/dubforge.db
# STORAGE_DIR=./storage
# SHARED_FOLDER_PATH=./shared

# Hardware Acceleration (VRAM in MB)
GPU_VRAM_MB=8192

# ------------------------------------------------------------------------------
# Observability & Partner Integrations (Optional)
# ------------------------------------------------------------------------------
# Parallel Search MCP (Cultural Research & Idioms)
PARALLEL_API_KEY=your_parallel_api_key_here

# ClickHouse Analytics MCP
CLICKHOUSE_URL=https://your-clickhouse-host:8443
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=your_password_here

